@model Platform.IdentityServer.Controllers.LoggedOutViewModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Logged Out</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; background-color: #f4f6f8; }
        .card { background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 340px; text-align: center; }
        h2 { margin-top: 0; color: #333; }
        a { color: #0066cc; text-decoration: none; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Logged Out</h2>
        <p>You have successfully logged out.</p>
        @if (!string.IsNullOrEmpty(Model.PostLogoutRedirectUri))
        {
            <p>Click <a href="@Model.PostLogoutRedirectUri">here</a> to return to <b>@Model.ClientName</b>.</p>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.SignOutIFrameUrl))
    {
        <iframe style="display:none" width="0" height="0" src="@Model.SignOutIFrameUrl"></iframe>
    }
</body>
</html>
