{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "ConnectionStrings": {
    "BookingsDb": "<SET_VIA_ENV_ConnectionStrings__BookingsDb>"
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "http://localhost:5005",
    "Audience": "platform-api",
    "SecretKey": "SuperSecretPlatformJwtKeyForDevTestingOnlyDoNotUseInProd12345!"
  },
  "IdentityServer": {
    "Authority": "http://localhost:5001",
    "Audience": "orders_api"
  },
  "Keycloak": {
    "Realm": "DevRealmDrivers",
    "AuthServerUrl": "http://localhost:8080"
  }
}
