{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/?maxPoolSize=50&serverSelectionTimeoutMS=5000",
    "DatabaseName": "detailing_reviews"
  },
  "LuckyPenny": {
    "LicenseKey": ""
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "http://localhost:5005",
    "Audience": "platform-api",
    "SecretKey": "SuperSecretPlatformJwtKeyForDevTestingOnlyDoNotUseInProd12345!"
  },
  "IdentityServer": {
    "Authority": "http://localhost:5001",
    "Audience": "reviews_api"
  },
  "Keycloak": {
    "Realm": "DevRealmDrivers",
    "AuthServerUrl": "http://localhost:8080"
  }
}
