{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "http://localhost:5005",
    "Audience": "platform-api",
    "SecretKey": "SuperSecretPlatformJwtKeyForDevTestingOnlyDoNotUseInProd12345!",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 5,
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Metadata": {
          "Team": "Security",
          "Version": "v1"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Order": 5,
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Metadata": {
          "Team": "Security",
          "Version": "v1"
        }
      },
      "auth-api-route": {
        "ClusterId": "auth-cluster",
        "Order": 5,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/auth/{**catch-all}" }
        ],
        "Metadata": {
          "Team": "Security",
          "Version": "v1"
        }
      },
      "users-api-route": {
        "ClusterId": "auth-cluster",
        "Order": 5,
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/users/{**catch-all}" }
        ],
        "Metadata": {
          "Team": "Security",
          "Version": "v1"
        }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Metadata": {
          "Team": "Payments",
          "Version": "v1"
        }
      },
      "aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "Metadata": {
          "Team": "Platform",
          "Version": "v1"
        }
      },
      "bookings-direct-route": {
        "ClusterId": "bookings-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        },
        "Metadata": {
          "Team": "Bookings",
          "Version": "v1"
        }
      },
      "bookings-route": {
        "ClusterId": "bookings-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        },
        "Metadata": {
          "Team": "Bookings",
          "Version": "v1"
        }
      },
      "clients-route": {
        "ClusterId": "bookings-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/clients/{**catch-all}"
        },
        "Metadata": {
          "Team": "Bookings",
          "Version": "v1"
        }
      },
      "catalog-services-bookings-route": {
        "ClusterId": "bookings-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/catalog-services/{**catch-all}"
        },
        "Metadata": {
          "Team": "Bookings",
          "Version": "v1"
        }
      },
      "catalog-direct-route": {
        "ClusterId": "catalog-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Metadata": {
          "Team": "Catalog",
          "Version": "v1"
        }
      },
      "catalog-services-route": {
        "ClusterId": "catalog-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/services/{**catch-all}"
        },
        "Metadata": {
          "Team": "Catalog",
          "Version": "v1"
        }
      },
      "catalog-categories-route": {
        "ClusterId": "catalog-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        },
        "Metadata": {
          "Team": "Catalog",
          "Version": "v1"
        }
      },
      "catalog-packages-route": {
        "ClusterId": "catalog-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/packages/{**catch-all}"
        },
        "Metadata": {
          "Team": "Catalog",
          "Version": "v1"
        }
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        },
        "Metadata": {
          "Team": "Reviews",
          "Version": "v1"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "auth-api": {
            "Address": "http://auth-api"
          }
        }
      },
      "payments-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "payments-api": {
            "Address": "http://payments-api"
          }
        }
      },
      "aggregator-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "aggregator": {
            "Address": "http://aggregator"
          }
        }
      },
      "bookings-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "bookings-api": {
            "Address": "http://bookings-api"
          }
        }
      },
      "catalog-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "catalog-api": {
            "Address": "http://catalog-api"
          }
        }
      },
      "reviews-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "reviews-api": {
            "Address": "http://reviews-api"
          }
        }
      }
    }
  }
}
