{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "Metadata": {
          "Team": "Platform",
          "Version": "v1"
        }
      },
      "bookings-direct-route": {
        "ClusterId": "bookings-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        },
        "Metadata": {
          "Team": "Bookings",
          "Version": "v1"
        }
      },
      "bookings-route": {
        "ClusterId": "bookings-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        },
        "Metadata": {
          "Team": "Bookings",
          "Version": "v1"
        }
      },
      "clients-route": {
        "ClusterId": "bookings-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/clients/{**catch-all}"
        },
        "Metadata": {
          "Team": "Bookings",
          "Version": "v1"
        }
      },
      "catalog-services-bookings-route": {
        "ClusterId": "bookings-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/catalog-services/{**catch-all}"
        },
        "Metadata": {
          "Team": "Bookings",
          "Version": "v1"
        }
      },
      "catalog-direct-route": {
        "ClusterId": "catalog-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Metadata": {
          "Team": "Catalog",
          "Version": "v1"
        }
      },
      "catalog-services-route": {
        "ClusterId": "catalog-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/services/{**catch-all}"
        },
        "Metadata": {
          "Team": "Catalog",
          "Version": "v1"
        }
      },
      "catalog-categories-route": {
        "ClusterId": "catalog-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        },
        "Metadata": {
          "Team": "Catalog",
          "Version": "v1"
        }
      },
      "catalog-packages-route": {
        "ClusterId": "catalog-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/packages/{**catch-all}"
        },
        "Metadata": {
          "Team": "Catalog",
          "Version": "v1"
        }
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        },
        "Metadata": {
          "Team": "Reviews",
          "Version": "v1"
        }
      }
    },
    "Clusters": {
      "aggregator-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "aggregator": {
            "Address": "http://aggregator"
          }
        }
      },
      "bookings-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "bookings-api": {
            "Address": "http://bookings-api"
          }
        }
      },
      "catalog-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "catalog-api": {
            "Address": "http://catalog-api"
          }
        }
      },
      "reviews-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "reviews-api": {
            "Address": "http://reviews-api"
          }
        }
      }
    }
  }
}
