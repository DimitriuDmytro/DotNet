// =========================================================================
// Проєкт №1: Контекст "Записи" (DetailingBookings)
// Формат: DBML (для візуалізації на https://dbdiagram.io)
// ВАЖЛИВО: Services.Id та AppointmentItems.ServiceId є ЛОГІЧНИМ посиланням
// на сутність Service у базі DetailingCatalog (без міжбазового FOREIGN KEY).
// =========================================================================

Project DetailingBookings {
  database_type: 'SQL Server'
  Note: 'Контекст Записів (Bookings) детейлінг-студії. Майбутній стек: ADO.NET + Dapper.'
}

Table Clients {
  Id bigint [pk, increment, note: 'Сурогатний PK']
  Email nvarchar(255) [not null, unique]
  FullName nvarchar(200) [not null]
  Phone nvarchar(30) [not null]
  CreatedAt datetime2 [not null, default: `SYSUTCDATETIME()`]
  CreatedBy nvarchar(100) [not null, default: 'system']
  UpdatedAt datetime2 [null]
  UpdatedBy nvarchar(100) [null]
  IsDeleted bit [not null, default: 0, note: 'Soft Delete']
}

Table Services {
  Id bigint [pk, note: 'БЕЗ IDENTITY! Логічна копія Id із бази DetailingCatalog (НЕ міжбазовий FK)']
  Name nvarchar(200) [not null, note: 'Копія для читання (оновлюється подіями з Каталогу)']
  Price decimal(18,2) [not null, note: 'CHECK (Price > 0)']
  DurationMin int [not null, note: 'CHECK (DurationMin > 0)']
  SyncedAt datetime2 [not null, default: `SYSUTCDATETIME()`]
}

Table Appointments {
  Id bigint [pk, increment, note: 'Корінь агрегата Appointment']
  ClientId bigint [not null, note: 'FK на Clients.Id (ON DELETE NO ACTION)']
  Status nvarchar(30) [not null, default: 'Booked', note: 'Booked -> CarReceived -> InProgress -> QualityCheck -> Ready -> Delivered | Cancelled']
  ScheduledAt datetime2 [not null]
  TotalAmount decimal(18,2) [not null, default: 0, note: 'CHECK (TotalAmount >= 0)']
  CreatedAt datetime2 [not null, default: `SYSUTCDATETIME()`]
  CreatedBy nvarchar(100) [not null, default: 'system']
  UpdatedAt datetime2 [null]
  UpdatedBy nvarchar(100) [null]
  IsDeleted bit [not null, default: 0]
  RowVersion rowversion [not null, note: 'Оптимістичне блокування']

  Indexes {
    (ClientId, Status) [name: 'IX_Appointments_ClientId_Status']
    (Status, ScheduledAt) [name: 'IX_Appointments_Status_ScheduledAt']
    (ClientId, ScheduledAt) [name: 'IX_Appointments_ClientId_Active']
  }
}

Table AppointmentDetails {
  AppointmentId bigint [pk, note: '1:1 із Appointments (PK = FK, ON DELETE CASCADE)']
  CarBrand nvarchar(100) [not null]
  CarModel nvarchar(100) [not null]
  PlateNumber nvarchar(20) [not null]
  Comment nvarchar(1000) [null]
}

Table AppointmentItems {
  AppointmentId bigint [pk, note: 'Складений PK (M:N), FK на Appointments (ON DELETE CASCADE)']
  ServiceId bigint [pk, note: 'Складений PK (M:N). ЛОГІЧНЕ посилання на DetailingCatalog.Services.Id (локальна перевірка по репліці dbo.Services)']
  ServiceName nvarchar(200) [not null, note: 'Знімок (Snapshot) назви на момент запису']
  UnitPrice decimal(18,2) [not null, note: 'Знімок (Snapshot) ціни на момент запису, CHECK (> 0)']
  Discount decimal(18,2) [not null, default: 0, note: 'CHECK (Discount >= 0)']
  Quantity int [not null, default: 1, note: 'CHECK (Quantity > 0)']
}

Table Payments {
  Id bigint [pk, increment]
  AppointmentId bigint [not null]
  Amount decimal(18,2) [not null, note: 'CHECK (Amount > 0)']
  Method nvarchar(30) [not null, note: 'Cash | Card | BankTransfer']
  PaidAt datetime2 [not null, default: `SYSUTCDATETIME()`]

  Indexes {
    (AppointmentId) [name: 'IX_Payments_AppointmentId']
  }
}

Table AppointmentStatusHistory {
  Id bigint [pk, increment]
  AppointmentId bigint [not null]
  OldStatus nvarchar(30) [null]
  NewStatus nvarchar(30) [not null]
  ChangedAt datetime2 [not null, default: `SYSUTCDATETIME()`]
  ChangedBy nvarchar(100) [not null, default: 'system']
}

// Зв'язки всередині бази DetailingBookings:
Ref FK_Appointments_Clients: Appointments.ClientId > Clients.Id [delete: no action] // 1:N
Ref FK_AppointmentDetails_Appointments: AppointmentDetails.AppointmentId - Appointments.Id [delete: cascade] // 1:1
Ref FK_AppointmentItems_Appointments: AppointmentItems.AppointmentId > Appointments.Id [delete: cascade] // 1:N (частина M:N)
Ref FK_AppointmentItems_Services: AppointmentItems.ServiceId > Services.Id [delete: no action] // 1:N до локальної репліки (логічне посилання на Каталог)
Ref FK_Payments_Appointments: Payments.AppointmentId > Appointments.Id [delete: no action] // 1:N
Ref FK_AppointmentStatusHistory_Appointments: AppointmentStatusHistory.AppointmentId > Appointments.Id [delete: no action] // 1:N
